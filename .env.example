# Supabase project for Digital Closet (Phase 3). Copy to .env.local and fill in.
# The publishable key is designed to ship in the app; Row Level Security protects the data.
# Never put a secret key (sb_secret_...) or service_role key in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
