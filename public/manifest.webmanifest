{
  "name": "Digital Closet",
  "short_name": "Closet",
  "description": "Your wardrobe in your pocket: pieces, outfits and what you wore.",
  "id": "./",
  "start_url": "./#closet",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log what I wore", "short_name": "Log outfit", "url": "./#worn", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Outfits", "url": "./#outfits", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
